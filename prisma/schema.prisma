// Mtaani Deals — production database schema
// Postgres, normalized, with explicit audit/status fields for the
// manual M-PESA verification workflow described in the product spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & roles
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER // default role for every account
  ADMIN // platform owner / staff with full management access
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A user keeps full customer capabilities even after registering a
  // business — "business" is a capability granted by owning a Business
  // record, not a mutually exclusive role. See spec section 29.
  businesses  Business[]
  savedDeals  SavedDeal[]
  payments    Payment[]
  auditLogs   AdminAuditLog[]     @relation("AuditActor")
  verifiedBusinesses Business[]   @relation("BusinessVerifiedBy")
  verifiedPayments   Payment[]    @relation("PaymentVerifiedBy")
  approvedDeals      Deal[]       @relation("DealApprovedBy")
  referralsMade      ReferralEvent[] @relation("Referrer")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Taxonomy
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  businesses Business[]
  deals      Deal[]
}

model County {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  businesses Business[]
  deals      Deal[]
}

// ---------------------------------------------------------------------------
// Businesses
// ---------------------------------------------------------------------------

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Business {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])

  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  countyId    String
  county      County   @relation(fields: [countyId], references: [id])
  location    String
  phone       String
  whatsapp    String?
  description String
  logoUrl     String?

  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  approvedById       String?
  approvedBy         User?    @relation("BusinessVerifiedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?

  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals              Deal[]
  payments           Payment[]
  subscriptions      Subscription[]
  featuredPeriods    FeaturedBusiness[]
  advertising        AdvertisingPlacement[]
  sponsoredDeals     SponsoredDeal[]
  referralsReceived  ReferralEvent[] @relation("ReferredBusiness")

  @@index([verificationStatus])
  @@index([ownerId])
  @@index([categoryId])
  @@index([countyId])
}

// ---------------------------------------------------------------------------
// Deals
// ---------------------------------------------------------------------------

enum DealStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  SUSPENDED
}

model Deal {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])

  title       String
  description String
  originalPrice Decimal @db.Decimal(12, 2)
  dealPrice     Decimal @db.Decimal(12, 2)
  // discountPercent and savings are always recomputed server-side from
  // originalPrice/dealPrice — never trusted from client input.
  discountPercent Int
  savings         Decimal @db.Decimal(12, 2)

  images      String[] @default([])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  countyId    String
  county      County   @relation(fields: [countyId], references: [id])
  location    String

  expiryDate  DateTime
  status      DealStatus @default(PENDING)
  rejectionReason String?
  approvedById    String?
  approvedBy      User?    @relation("DealApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?

  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedBy         SavedDeal[]
  boosts          DealBoost[]
  sponsored       SponsoredDeal[]

  @@index([status])
  @@index([businessId])
  @@index([expiryDate])
  @@index([categoryId])
  @@index([countyId])
}

model SavedDeal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, dealId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Monetization: packages, payments, subscriptions, promotions
// ---------------------------------------------------------------------------

enum PackageType {
  BUSINESS_SUBSCRIPTION
  FEATURED_BUSINESS
  DEAL_BOOST
  SPONSORED_DEAL
  ADVERTISING
}

model PromotionPackage {
  id          String      @id @default(cuid())
  type        PackageType
  name        String
  description String?
  durationDays Int
  price       Decimal     @db.Decimal(12, 2)
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  payments        Payment[]
  subscriptions   Subscription[]
  featuredPeriods FeaturedBusiness[]
  dealBoosts      DealBoost[]
  sponsoredDeals  SponsoredDeal[]
  advertising     AdvertisingPlacement[]

  @@index([type, active])
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

// Every paid product (subscription, featured business, deal boost,
// sponsored deal, advertising) creates exactly one Payment record that
// tracks the manual M-PESA verification workflow. Nothing activates until
// an admin sets status = VERIFIED.
model Payment {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  packageId   String
  package     PromotionPackage @relation(fields: [packageId], references: [id])

  amount      Decimal       @db.Decimal(12, 2)
  mpesaReceivingNumber String  // snapshot of the platform number at time of submission
  transactionCode      String
  status      PaymentStatus @default(PENDING_VERIFICATION)

  submittedAt DateTime      @default(now())
  verifiedAt  DateTime?
  verifiedById String?
  verifiedBy  User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id])
  rejectionReason String?

  subscription    Subscription?
  featuredPeriod  FeaturedBusiness?
  dealBoost       DealBoost?
  sponsoredDeal   SponsoredDeal?
  advertising     AdvertisingPlacement?

  @@index([status])
  @@index([businessId])
  @@unique([transactionCode])
}

enum SubscriptionStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  EXPIRED
}

model Subscription {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  packageId   String
  package     PromotionPackage @relation(fields: [packageId], references: [id])
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])

  status      SubscriptionStatus @default(PENDING_VERIFICATION)
  startDate   DateTime?
  endDate     DateTime?
  verifiedAt  DateTime?
  verifiedById String?
  rejectionReason String?

  createdAt   DateTime @default(now())

  @@index([businessId, status])
}

enum PromotionStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  EXPIRED
}

model FeaturedBusiness {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  packageId   String
  package     PromotionPackage @relation(fields: [packageId], references: [id])
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])

  status      PromotionStatus @default(PENDING_VERIFICATION)
  startDate   DateTime?
  endDate     DateTime?

  // Explicit, audited admin override — never granted implicitly.
  isAdminException Boolean @default(false)
  exceptionReason  String?
  exceptionGrantedById String?

  createdAt   DateTime @default(now())

  @@index([businessId, status])
  @@index([status, endDate])
}

model DealBoost {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id])
  packageId   String
  package     PromotionPackage @relation(fields: [packageId], references: [id])
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])

  status      PromotionStatus @default(PENDING_VERIFICATION)
  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime @default(now())

  @@index([dealId, status])
  @@index([status, endDate])
}

model SponsoredDeal {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id])
  packageId   String
  package     PromotionPackage @relation(fields: [packageId], references: [id])
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])

  placement   String?
  status      PromotionStatus @default(PENDING_VERIFICATION)
  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime @default(now())

  @@index([status, endDate])
}

enum AdPlacementType {
  HOMEPAGE_BANNER
  CATEGORY_BANNER
  SPONSORED_CARD
  PROMOTIONAL_PLACEMENT
}

enum AdStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
}

model AdvertisingPlacement {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  packageId   String
  package     PromotionPackage @relation(fields: [packageId], references: [id])
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])

  placement   AdPlacementType
  creativeUrl String
  destinationUrl String

  status      AdStatus @default(PENDING_APPROVAL)
  approvedById String?
  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime @default(now())

  @@index([placement, status])
  @@index([status, endDate])
}

// ---------------------------------------------------------------------------
// Future referrals/commissions — architecture only, disabled by default.
// ---------------------------------------------------------------------------

enum ReferralStatus {
  DISABLED
  PENDING
  CONFIRMED
  PAID
  CANCELLED
}

model ReferralEvent {
  id                 String   @id @default(cuid())
  referrerUserId     String
  referrer           User     @relation("Referrer", fields: [referrerUserId], references: [id])
  referredBusinessId String
  referredBusiness   Business @relation("ReferredBusiness", fields: [referredBusinessId], references: [id])
  commissionAmount   Decimal? @db.Decimal(12, 2)
  status             ReferralStatus @default(DISABLED)
  createdAt          DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Platform settings (admin-configurable, no source-code changes required)
// ---------------------------------------------------------------------------

model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AuditActor", fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
  @@index([createdAt])
}
