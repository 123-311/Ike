# Copy this file to .env (development) or configure these as real
# environment variables in your production host. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://mtaani:CHANGE_ME@localhost:5432/mtaani_deals"

# Long random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"

# Set to "production" on a real deployment.
NODE_ENV="development"

# Seed script creates one bootstrap admin using these credentials.
# Change the password immediately after first login in production.
SEED_ADMIN_EMAIL="admin@mtaanideals.co.ke"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Secret the hosting platform's scheduler must send as
# "Authorization: Bearer <CRON_SECRET>" when calling /api/cron/sweep-expired
# to expire deals/promotions on a schedule. Generate with:
#   openssl rand -hex 32
CRON_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"
